---
import "../styles/global.css";
import { localePath } from "../i18n";
import { href } from "../lib/url";

// GitHub Pages sirve este archivo para cualquier dirección que no existe, a
// cualquier profundidad: por eso todas las rutas son absolutas (con la base).
// No pertenece a ningún idioma, así que lleva los dos.
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Página no encontrada · Page not found — Recompendium</title>
    <link rel="icon" type="image/svg+xml" href={href("pastel.svg")} />
    <!-- El tema y la letra, como en Base.astro. -->
    <script is:inline>
      try {
        var t = localStorage.getItem("recompendium-tema");
        if (!t && matchMedia("(prefers-color-scheme: light)").matches) t = "dia";
        if (t === "dia" || t === "contraste") document.documentElement.dataset.tema = t;
      } catch (e) {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="wrap lang-pick not-found">
      <a class="brand nf-logo" href={href()}>
        <img class="brand-pie" src={href("pastel.svg")} alt="" width="44" height="44" />
        <span class="mark">Recompendium</span>
      </a>
      <h1>404</h1>
      <div class="nf-text">
        <p lang="es">No encontramos esta página. Puede que la dirección esté mal escrita o que la ficha haya cambiado de nombre.</p>
        <p lang="en">We couldn’t find this page. The address may be mistyped, or the entry may have been renamed.</p>
      </div>
      <ul>
        <li><a href={localePath("es")} hreflang="es" lang="es">Ir al catálogo</a></li>
        <li><a href={localePath("en")} hreflang="en" lang="en">Go to the catalog</a></li>
      </ul>
    </main>
  </body>
</html>
