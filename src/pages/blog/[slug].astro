---
import type { GetStaticPaths } from "astro";
import BlogPostPage from "../../components/pages/BlogPostPage.astro";
import { getPosts, postSlug } from "../../lib/blog";

export const getStaticPaths = (async () => {
  const posts = await getPosts("es");
  return posts.map((entry) => ({ params: { slug: postSlug(entry) }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
---

<BlogPostPage lang="es" entry={entry} />
