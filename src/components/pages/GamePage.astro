---
import Base from "../../layouts/Base.astro";
import Card from "../Card.astro";
import { consoleMeta, inkOn } from "../../lib/consoles";
import instalables from "../../data/unricopie.json";
import { getGames, projectsByGame, launchersFor, coverOf, COVER_W, COVER_H } from "../../lib/games";
import type { Item } from "../../lib/catalog";
import { t, localePath, type Lang, type UIKey } from "../../i18n";

interface Props {
  lang: Lang;
  id: string;
}
// Una página por juego con todos sus proyectos: es la que responde a búsquedas
// como «Super Mario 64 en PC» o a la pregunta a un asistente «¿se puede jugar X
// en PC?». Las respuestas salen de los datos de las fichas, no se escriben a mano.
const { lang, id } = Astro.props;
const game = (await getGames()).get(id)!;
const items = (await projectsByGame(lang)).get(id) ?? [];
const installers = await launchersFor(id, items, lang);

// «5 ports y 1 decompilación» / «5 ports and 1 decompilation».
const ORDER = ["recomp", "port", "decomp", "mod", "tool"] as const;
function joinList(parts: string[]): string {
  if (parts.length <= 1) return parts.join("");
  const and = t(lang, "game.and");
  const head = parts.slice(0, -1).join(", ");
  return lang === "en" && parts.length > 2 ? `${head}, ${and} ${parts.at(-1)}` : `${head} ${and} ${parts.at(-1)}`;
}
const listOf = (its: Item[]) =>
  joinList(
    ORDER.map((ty) => [ty, its.filter((i) => i.type === ty).length] as const)
      .filter(([, n]) => n > 0)
      .map(([ty, n]) => t(lang, `game.n.${ty}.${n === 1 ? "1" : "n"}` as UIKey, { n })),
  );
const summary = listOf(items);

const platformLabel = (p: string) => (p === "other" ? "" : consoleMeta(p, lang).label);
const platforms = game.platforms.map(platformLabel).filter(Boolean);
// Un juego de PC ya se juega en PC: la pregunta útil es qué proyectos hay.
const PC_LIKE = new Set(["pc", "dos", "mac", "macos", "pc98", "other", "mobile"]);
const fromPc = game.platforms.length > 0 && game.platforms.every((p) => PC_LIKE.has(p));

// Respuestas, a partir del estado de cada proyecto. Las fichas retiradas por
// DMCA no cuentan: ya no se pueden descargar.
const live = items.filter((i) => !i.takedown);
const playables = live.filter((i) => i.type === "recomp" || i.type === "port");
const full = playables.filter((i) => i.statusKey === "fully").length;
const playable = playables.filter((i) => i.statusKey === "playable" || i.statusKey === "fully").length;
function nativeAnswer(): string {
  const n = playables.length;
  const list = listOf(playables);
  const pick = (kind: "full" | "playable", k: number) =>
    t(lang, `game.a.${kind}.${n === 1 ? "single" : k === n ? "all" : k === 1 ? "one" : "many"}` as UIKey, { list, k });
  if (!n) return t(lang, live.some((i) => i.type === "decomp") ? "game.a.decompOnly" : "game.a.projects", { list: listOf(live), name: game.name });
  if (full) return pick("full", full);
  if (playable) return pick("playable", playable);
  return t(lang, "game.a.wip", { list });
}
const faqs: { q: string; a: string; link?: Item }[] = [];
if (fromPc || !playables.length && !live.some((i) => i.type === "decomp")) {
  faqs.push({ q: t(lang, "game.q.projects", { name: game.name }), a: t(lang, "game.a.projects", { list: summary, name: game.name }) });
} else {
  faqs.push({ q: t(lang, "game.q.native", { name: game.name }), a: nativeAnswer() });
}
const mainPlatform = platforms[0];
faqs.push({
  q: t(lang, "game.q.need"),
  a: t(lang, "game.a.need", { name: game.name, platform: mainPlatform ?? "" }).replace(" ()", ""),
});
const top = [...(playables.length ? playables : live)].filter((i) => (i.stars ?? 0) > 0).sort((a, b) => b.stars! - a.stars!)[0];
if (top) {
  faqs.push({
    q: t(lang, "game.q.top"),
    a: t(lang, "game.a.top", { project: top.name, stars: top.stars!.toLocaleString(lang === "es" ? "es-ES" : "en-US") }),
    link: top,
  });
}
// Cuál está más avanzado: solo si hay más de uno donde elegir.
const fulls = playables.filter((i) => i.statusKey === "fully");
const plays = playables.filter((i) => i.statusKey === "playable");
const best = fulls.length ? { kind: "full", its: fulls } : plays.length ? { kind: "playable", its: plays } : null;
if (best && playables.length > 1) {
  faqs.push({
    q: t(lang, "game.q.best"),
    a: t(lang, `game.a.best.${best.kind}.${best.its.length === 1 ? "1" : "n"}` as UIKey, { list: joinList(best.its.map((i) => i.name)) }),
  });
}
// Si se sigue moviendo: el último cambio en el repo de cualquiera de sus proyectos.
const latest = live.filter((i) => i.pushedAt).sort((a, b) => b.pushedAt!.localeCompare(a.pushedAt!))[0];
if (latest) {
  const when = new Date(latest.pushedAt!);
  const date = when.toLocaleDateString(lang === "es" ? "es-ES" : "en-US", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
  const recent = Date.now() - when.getTime() < 365 * 86_400_000;
  faqs.push({ q: t(lang, "game.q.active"), a: t(lang, recent ? "game.a.active.recent" : "game.a.active.old", { date, project: latest.name }) });
}
// Versiones para otras plataformas, según las etiquetas build-* de cada ficha.
const BUILDS = ["android", "ios", "switch", "3ds", "vita", "web"] as const;
const others = live
  .map((i) => ({ it: i, plats: BUILDS.filter((b) => i.tags.includes(`build-${b}`)).map((b) => t(lang, `game.build.${b}` as UIKey)) }))
  .filter((o) => o.plats.length > 0);
if (others.length) {
  faqs.push({
    q: t(lang, "game.q.other"),
    a: t(lang, "game.a.other", { list: others.map((o) => `${o.it.name} (${joinList(o.plats)})`).join("; ") }),
  });
}
const cover = coverOf(id);
// Diseño v3: la franja de la consola principal, el estudio y el año, y el botón dorado
// si Unricopie sabe instalar alguno de sus proyectos.
const consola = game.platforms.find((p) => p !== "other");
const cm = consola ? consoleMeta(consola, lang) : null;
const franja = cm ? `--c:${cm.color};--ci:${inkOn(cm.color)}` : undefined;
const studio = items.find((i) => i.originalDeveloper)?.originalDeveloper;
const origen = [studio, game.year].filter(Boolean).join(", ");
const instalable = new Set((instalables as { instalables: string[] }).instalables);
const conUnricopie = items.some((i) => instalable.has(`${i.type === "tool" ? "tools" : i.type === "decomp" ? "decomps" : i.type + "s"}/${i.id}`));

const title = `${t(lang, "game.seoTitle", { name: game.name, summary })} — Recompendium`;
const description = faqs[0].a;
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const url = abs(localePath(lang, `juego/${id}`));
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "VideoGame",
    name: game.name,
    url,
    inLanguage: lang,
    gamePlatform: game.platforms.filter((p) => p !== "other").map((p) => consoleMeta(p, lang).full),
    datePublished: game.year ? String(game.year) : undefined,
    image: cover ? abs(cover) : undefined,
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: summary,
    numberOfItems: items.length,
    itemListElement: items.map((it, n) => ({ "@type": "ListItem", position: n + 1, name: it.name, url: abs(it.href) })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Recompendium", item: abs(localePath(lang, "")) },
      { "@type": "ListItem", position: 2, name: t(lang, "game.crumb"), item: abs(localePath(lang, "juegos")) },
      { "@type": "ListItem", position: 3, name: game.name, item: url },
    ],
  },
];
---

<Base lang={lang} title={title} description={description} jsonLd={jsonLd}>
  <main class="v3">
    {cm && (<div class="cfranja" style={franja}><div class="wrap"><span>{cm.full}</span>{origen && <span>{origen}</span>}</div></div>)}
    <div class="wrap web">
      <div class="izq">
        <div class="crumb"><a href={localePath(lang, "juegos")}>{t(lang, "game.crumb")}</a></div>
        <div>
          <h1>{game.name}</h1>
          <p class="orig">{[...platforms, game.year, t(lang, "game.projects", { n: items.length })].filter(Boolean).join(" · ")}</p>
        </div>
        {
          (cover || conUnricopie) && (
            <div class="movil-accion">
              {cover && (<span class="caja-mini" style={franja}>{cm && <span class="franja">{cm.tag}</span>}<img src={cover} width={COVER_W} height={COVER_H} alt="" /></span>)}
              {conUnricopie && <a class="instalar" href={localePath(lang, "unricopie")}>{t(lang, "unricopie.install")}</a>}
            </div>
          )
        }
        <p class="short-answer"><span class="reqs-k">{t(lang, "game.short")}</span>{faqs[0].a} {t(lang, "game.shortNeed", { name: game.name, platform: mainPlatform ?? "" }).replace(" ()", "")}</p>

        <h2 class="h">{t(lang, "game.dl.projects")} <small>{items.length}</small></h2>
        {/* Cada proyecto, en su tarjeta completa: descripción, «Necesitas», estado y estrellas (11-11). */}
        <section class="grid" style="padding:0">{items.map((it) => <Card item={it} lang={lang} />)}</section>

        {
          installers.length > 0 && (
            <>
              <h2 class="h">{t(lang, "game.installedWith")}</h2>
              <p class="game-links">{installers.map((l, i) => (<>{i > 0 && " · "}<a href={l.href}>{l.name}</a></>))}</p>
            </>
          )
        }

        <h2 class="h">{t(lang, "game.faq")}</h2>
        <div class="prose faq">
          {
            faqs.map((f) => (
              <>
                <h3>{f.q}</h3>
                <p>{f.link ? <><a href={f.link.href}>{f.link.name}</a>{f.a.slice(f.link.name.length)}</> : f.a}</p>
              </>
            ))
          }
        </div>
      </div>

      <aside class="der">
        {
          cover && (
            <span class="caja" style={franja}>
              {cm && <span class="franja">{cm.label}</span>}
              <img src={cover} width={COVER_W} height={COVER_H} alt={t(lang, "game.coverAlt", { name: game.name })} />
            </span>
          )
        }
        {conUnricopie && <a class="instalar" href={localePath(lang, "unricopie")}>{t(lang, "unricopie.install")}</a>}
        <dl class="dl">
          {cm && (<><dt>{t(lang, "game.dl.console")}</dt><dd>{platforms.join(", ")}</dd></>)}
          {origen && (<><dt>{t(lang, "game.dl.original")}</dt><dd>{origen}</dd></>)}
          <dt>{t(lang, "game.dl.projects")}</dt><dd>{summary}</dd>
        </dl>
        <div class="necesitas"><b>{t(lang, "card.reqs")}</b> {faqs[1].a}</div>
      </aside>
    </div>
  </main>
</Base>
