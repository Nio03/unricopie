---
import Base from "../../layouts/Base.astro";
import { localePath, type Lang } from "../../i18n";
import { GITHUB_URL } from "../../lib/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const es = lang === "es";
const C = localePath(lang, "contribuir");
const T = localePath(lang, "terms");

const title = es ? "Preguntas frecuentes — Recompendium" : "FAQ — Recompendium";
const h1 = es ? "Preguntas frecuentes" : "Frequently asked questions";
const lead = es ? "Lo que más nos preguntan sobre el catálogo." : "What we get asked most about the catalog.";

const faqs = es
  ? [
      { q: "¿Por qué no hay enlaces de descarga directa?", a: "Siempre te enviamos al <b>repositorio oficial</b> del proyecto. Es la fuente legítima y la más segura, porque evita binarios manipulados o copias falsas, y siempre tiene la última versión. Recompendium no aloja binarios ni los vuelve a publicar: solo cataloga y enlaza." },
      { q: "¿Necesito el juego original?", a: "Sí. Tienes que aportar tu propia copia legal del juego (tu ROM o tu imagen de disco). Casi todos estos proyectos son <b>solo código</b>: el recomp o el port la usa, pero no la incluye. Si alguno trae archivos del juego, es porque declara tener el permiso explícito de sus titulares." },
      { q: "¿Qué diferencia hay entre un recomp, un port y una decompilación?", a: "Un <b>recomp</b> traduce el binario original a código nativo, y el resultado ya es un ejecutable. Un <b>port</b> o un <b>remake</b> llega al mismo juego por otro camino. Una <b>decompilación</b> reconstruye el código fuente del juego a partir del binario: mostramos su porcentaje de avance, pero por sí sola no es un juego que puedas ejecutar." },
      { q: "¿Cómo se mantienen actualizados los datos?", a: "Con tres fuentes: el <b>repositorio oficial</b> (estrellas, versión y fecha, a diario mediante la API de GitHub), <b>decomp.dev</b> y <b>ByteMatch</b> (el porcentaje de cada decompilación) y las <b>aportaciones</b> de la comunidad, que revisamos a mano." },
      { q: "¿Cómo añado o corrijo un proyecto?", a: `Con el formulario de <a href="${C}">Contribuir</a> o el botón <b>Editar</b> de cada ficha. Completas los datos en tu idioma; tu envío llega como propuesta y lo revisamos antes de publicarlo.` },
      { q: "¿Qué pasa si un proyecto se retira por una reclamación DMCA?", a: `A veces una decompilación o un port recibe una reclamación de derechos de autor y su repositorio desaparece. Como <b>solo enlazamos</b> y no alojamos nada, marcamos la ficha como <b>Retirado</b>, quitamos el enlace al repositorio y la conservamos como registro de la escena. ¿Eres titular de derechos y quieres que retiremos una ficha? <a href="${GITHUB_URL}/issues">Abre un issue</a>.` },
      { q: "¿Esto es legal?", a: `El código de estos proyectos es abierto. Lo que exige una copia legal es el <b>juego</b>: la ROM o la imagen de disco las pones tú. Recompendium no distribuye material protegido por derechos de autor (consulta los <a href="${T}">Términos</a>).` },
    ]
  : [
      { q: "Why are there no direct download links?", a: "We always send you to the project’s <b>official repository</b>. It’s the legitimate source and the safest one, since it avoids tampered binaries and fake copies, and it always has the latest version. Recompendium doesn’t host or re-host binaries: it only catalogs and links." },
      { q: "Do I need the original game?", a: "Yes. You have to supply your own legal copy of the game (your ROM or disc image). Almost all of these projects are <b>code only</b>: the recomp or port uses it, but doesn’t include it. If one ships game files, it’s because it states it has the rights holder’s explicit permission." },
      { q: "What’s the difference between a recomp, a port, and a decompilation?", a: "A <b>recomp</b> translates the original binary into native code, and the result is already an executable. A <b>port</b> or <b>remake</b> reaches the same game by another route. A <b>decompilation</b> rebuilds the game’s source code from the binary: we show its progress percentage, but on its own it isn’t a game you can run." },
      { q: "How is the data kept up to date?", a: "From three sources: the <b>official repository</b> (stars, version, and date, daily through the GitHub API), <b>decomp.dev</b> and <b>ByteMatch</b> (each decompilation’s percentage), and community <b>contributions</b>, which we review by hand." },
      { q: "How do I add or fix a project?", a: `Use the <a href="${C}">Contribute</a> form or the <b>Edit</b> button on any entry. You fill in the fields in your language; your submission arrives as a proposal, and we review it before publishing it.` },
      { q: "What happens if a project is taken down by a DMCA claim?", a: `Sometimes a decompilation or a port gets a copyright claim and its repository disappears. Since we <b>only link</b> and host nothing, we mark the entry as <b>Taken down</b>, remove the repository link, and keep the entry as a record of the scene. Are you a rights holder who wants an entry removed? <a href="${GITHUB_URL}/issues">Open an issue</a>.` },
      { q: "Is this legal?", a: `These projects’ code is open source. What requires a legal copy is the <b>game</b>: you provide the ROM or disc image. Recompendium doesn’t distribute copyrighted material (see the <a href="${T}">Terms</a>).` },
    ];
---

<Base lang={lang} title={title} description={lead}>
  <main class="wrap detail">
    <div class="crumb"><a href={localePath(lang, "")}>← {es ? "Catálogo" : "Catalog"}</a></div>
    <h1>{h1}</h1>
    <p class="lead">{lead}</p>
    <div class="prose">
      {faqs.map((f) => (<><h2>{f.q}</h2><p set:html={f.a} /></>))}
    </div>
  </main>
</Base>
