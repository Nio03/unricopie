---
import CatalogView from "./CatalogView.astro";
import { getModItems } from "../../lib/catalog";
import { t, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const items = await getModItems(lang);
---

<CatalogView
  lang={lang}
  items={items}
  h1={t(lang, "mods.title")}
  tagline={t(lang, "mods.intro")}
  countTmpl={t(lang, "count.modsOf")}
/>
