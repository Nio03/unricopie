---
import Base from "../../layouts/Base.astro";
import Card from "../Card.astro";
import { CONSOLE_KEYS, consoleMeta, inkOn } from "../../lib/consoles";
import { coverOf, COVER_W, COVER_H } from "../../lib/games";
import { fmtStars } from "../../lib/stats";
import { sortItems, TYPE_COLOR, type Item } from "../../lib/catalog";
import { t, localePath, type Lang } from "../../i18n";
import unricopie from "../../data/unricopie.json";

interface Props {
  lang: Lang;
  items: Item[];
  h1: string;
  tagline: string;
  countTmpl: string;
  guide?: boolean;
  typeFilter?: boolean;
  stats?: { n: number; label: string }[];
  // Bloque «Qué hace distinto a Recompendium», solo en la portada.
  why?: boolean;
  // Título para buscadores, si no basta con el h1; descripción para
  // buscadores, si no basta con el tagline; y datos estructurados.
  title?: string;
  description?: string;
  jsonLd?: object | object[];
  // Solo la lista con los filtros, sin estantes ni «‹ Volver». Es la vista de todas las páginas
  // desde el 11-11: los estantes escondían la información de cada ficha (auditoría).
  lista?: boolean;
}
const { lang, items, h1, tagline, countTmpl, guide = false, typeFilter = false, stats, why = false, title, description, jsonLd, lista = true } = Astro.props;

// Unricopie (la ficha con `ours`) va primera en las listas de launchers y herramientas: la página
// de Launchers, su estante y el filtro «Launchers y herramientas» (11-11). En el resto, en su sitio.
const oursFirst = (l: Item[]) => [...l.filter((i) => i.ours), ...l.filter((i) => !i.ours)];
const soloHerramientas = items.length > 0 && items.every((i) => i.type === "tool");
const ordered = soloHerramientas ? oursFirst(sortItems(items)) : sortItems(items);

// Las consolas de esta página, de la que más fichas tiene a la que menos.
const nPorConsola = new Map<string, number>();
for (const i of items) for (const c of i.consoleKeys) nPorConsola.set(c, (nPorConsola.get(c) ?? 0) + 1);
const consoles = CONSOLE_KEYS.filter((k) => nPorConsola.has(k))
  .map((k) => ({ key: k, n: nPorConsola.get(k)!, ...consoleMeta(k, lang) }))
  .sort((a, b) => b.n - a.n);
// En la columna de filtros, de la A a la Z y todas a la vista; «Otra», al final.
const consolasAZ = [...consoles].sort((a, b) => Number(a.key === "other") - Number(b.key === "other") || a.label.localeCompare(b.label, lang, { numeric: true }));

// Filtro de estado con los estados que de verdad tienen las fichas de esta
// página: las herramientas usan otros (beta, usable, estable) y las
// decompilaciones no tienen ninguno, así que ahí el filtro no aparece.
const STATUS_LABEL: Record<string, string> = {
  experimental: t(lang, "status.experimental"),
  playable: t(lang, "status.playable"),
  fully: t(lang, "status.fully"),
  beta: t(lang, "toolstatus.beta"),
  usable: t(lang, "toolstatus.usable"),
  stable: t(lang, "toolstatus.stable"),
};
const statusOptions = Object.keys(STATUS_LABEL).filter((s) => items.some((i) => i.statusKey === s));
const hasAbandoned = items.some((i) => i.abandoned);
const hasTakedown = items.some((i) => i.takedown);
const showStatus = statusOptions.length > 0 || hasAbandoned || hasTakedown;

const types = (
  [
    { key: "recomp", label: t(lang, "ctl.typeRecomps"), color: TYPE_COLOR.recomp },
    { key: "tool", label: t(lang, "ctl.typeTools"), color: TYPE_COLOR.tool },
    { key: "port", label: t(lang, "ctl.typePorts"), color: TYPE_COLOR.port },
    { key: "decomp", label: t(lang, "ctl.typeDecomps"), color: TYPE_COLOR.decomp },
    { key: "mod", label: t(lang, "ctl.typeMods"), color: TYPE_COLOR.mod },
  ] as const
)
  .filter((c) => items.some((i) => i.type === c.key))
  .map((c) => ({ ...c, n: items.filter((i) => i.type === c.key).length }));

// Explorar, como Nexus Mods: al entrar, estantes; «Ver todos» abre la cuadrícula con la columna
// de filtros. Cada estante lleva sus primeras fichas (se ve una fila) y lo que marca «Ver todos».
const ucList = (unricopie as { instalables: string[] }).instalables;
const instalable = (i: Item) => !i.takedown && ucList.includes(`${i.type === "decomp" ? "decomps" : i.type + "s"}/${i.id}`);
const nInstalables = items.filter(instalable).length;
const SHELF = 12;
type Shelf = { key: string; title: string; color?: string; n: number; items: Item[]; group?: string; value?: string; sort?: string };
const shelves: Shelf[] = [];
if (nInstalables) shelves.push({ key: "uc", title: t(lang, "shelf.installable"), n: nInstalables, items: ordered.filter(instalable).slice(0, SHELF), group: "uc", value: "1" });
const conEstrellas = items.filter((i) => i.stars != null);
if (conEstrellas.length > SHELF)
  shelves.push({ key: "pop", title: t(lang, "shelf.popular"), n: items.length, items: [...conEstrellas].sort((a, b) => (b.stars ?? 0) - (a.stars ?? 0)).slice(0, SHELF), sort: "stars" });
const conFecha = items.filter((i) => i.pushedAt);
if (conFecha.length > SHELF)
  shelves.push({ key: "upd", title: t(lang, "shelf.updated"), n: items.length, items: [...conFecha].sort((a, b) => (b.pushedAt ?? "").localeCompare(a.pushedAt ?? "")).slice(0, SHELF), sort: "updated" });
if (typeFilter && types.length > 1)
  for (const ty of types) {
    const deTipo = ordered.filter((i) => i.type === ty.key);
    shelves.push({ key: `t-${ty.key}`, title: ty.label, color: ty.color, n: ty.n, items: (ty.key === "tool" ? oursFirst(deTipo) : deTipo).slice(0, SHELF), group: "type", value: ty.key });
  }
if (consoles.length > 1)
  for (const c of consoles.slice(0, 6)) shelves.push({ key: `c-${c.key}`, title: c.label, color: c.color, n: c.n, items: ordered.filter((i) => i.consoleKeys.includes(c.key)).slice(0, SHELF), group: "console", value: c.key });
// En los estantes, cada ficha es una caja (la portada con la franja de su consola), como en la
// página de juegos y en Unricopie; la tarjeta con el texto entero queda para «Ver todos».
const cajaDe = (i: Item) => {
  const g = i.games.find((x) => coverOf(x));
  const cm = i.consoleKeys[0] ? consoleMeta(i.consoleKeys[0], lang) : null;
  // El estado y las estrellas van en piezas aparte: si no caben en una línea, las estrellas bajan
  // enteras a la siguiente en lugar de partirse.
  const sub = [i.status?.label, i.stars != null ? `★ ${fmtStars(i.stars)}` : null].filter((x): x is string => Boolean(x));
  // Sin consola (un motor para varios juegos, como OpenRA), la franja dice su tipo en un color
  // neutro: así todas las cajas del estante miden lo mismo.
  const franja = cm ? { label: cm.tag, style: `--c:${cm.color};--ci:${inkOn(cm.color)}` } : { label: i.kindLabel, style: "--c:var(--panel-2);--ci:var(--ink-2)" };
  return { cover: g ? coverOf(g) : null, franja, sub };
};

// Va en el hero, antes de las fichas, a propósito: la portada pesa casi 3 MB
// y los lectores de las IAs la cortan mucho antes del final. Lo que no esté en
// los primeros KB no lo leen, y en octubre de 2026 un asistente dejó fuera el
// sitio porque «solo vi su página de inicio».
const whyItems = (["curated", "copy", "status", "ai", "live", "open"] as const).map((k) => ({
  t: t(lang, `why.${k}.t`),
  b: t(lang, `why.${k}.b`, { contribute: `<a href="${localePath(lang, "contribuir")}">${t(lang, "nav.contribute")}</a>` }),
}));

const guideCards = [
  { key: "recomp", color: TYPE_COLOR.recomp },
  { key: "port", color: TYPE_COLOR.port },
  { key: "decomp", color: TYPE_COLOR.decomp },
  { key: "tool", color: TYPE_COLOR.tool },
  { key: "mod", color: TYPE_COLOR.mod },
] as const;
---

<Base lang={lang} title={title ?? (h1.includes("<") ? t(lang, "site.title") : `${h1} — Recompendium`)} description={description ?? tagline} jsonLd={jsonLd}>
  <header class="hero">
    <div class="wrap">
      <div class="brandrow"><h1 class="logo" set:html={h1} /></div>
      <p class="tag">{tagline}</p>
      {
        guide && (
          <div class="guide">
            {guideCards.map((g) => (
              <div class="g" style={`--gc:${g.color}`}>
                <h3>{t(lang, `guide.${g.key}.t`)}</h3>
                <p>{t(lang, `guide.${g.key}.b`)}</p>
              </div>
            ))}
          </div>
        )
      }
      {
        stats && (
          <div class="stat-row">
            {stats.map((s) => (<div class="stat"><b>{s.n}</b><span>{s.label}</span></div>))}
          </div>
        )
      }
      {why && (<p class="by-game"><a href={localePath(lang, "juegos")}>{t(lang, "home.byGame")}</a></p>)}
      {
        why && (
          <section class="why" aria-labelledby="why-title">
            <h2 id="why-title">{t(lang, "why.title")}</h2>
            <ul>
              {whyItems.map((w) => (<li><b>{w.t}</b> <span set:html={w.b} /></li>))}
            </ul>
          </section>
        )
      }
    </div>
  </header>

  <div class="controls">
    <div class="wrap">
      <div class="crow">
        <div class="search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            ><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg
          >
          <input id="q" type="search" placeholder={t(lang, "ctl.searchPlaceholder")} aria-label={t(lang, "ctl.search")} />
        </div>
      </div>
    </div>
  </div>

  {/* Sin JavaScript se ve «Ver todos» con la cuadrícula entera: así la leen igual los
      buscadores, y ninguna ficha queda solo dentro de un estante. */}
  <noscript><style>.explorar .inicio {display: none !important} .explorar .todos {display: grid !important} .filtros {display: none !important}</style></noscript>
  <main class="wrap explorar" id="explorar" data-vista={lista ? "todos" : "inicio"}>
    {!lista && (<section class="inicio" aria-label={t(lang, "ctl.shelves")}>
      <p class="ver-todo"><button class="ver-todos" type="button" data-sort="">{t(lang, "ctl.seeAllN", { n: ordered.length })}</button></p>
      {shelves.map((s) => (
        <section class="estante-f">
          <header>
            {s.color && <i style={`--c:${s.color}`} />}
            <h2>{s.title}</h2>
            <span class="n">{s.n}</span>
            <button class="ver-todos" type="button" data-group={s.group ?? ""} data-value={s.value ?? ""} data-sort={s.sort ?? ""}>{t(lang, "ctl.seeAll")}</button>
          </header>
          <ul class="estante fila">
            {s.items.map((item) => {
              const c = cajaDe(item);
              return (
                <li>
                  <a class="caja-j" href={item.href} target={item.external ? "_blank" : undefined} rel={item.external ? "noopener" : undefined}>
                    <span class="caja" style={c.franja?.style}>
                      {c.franja && <span class="franja">{c.franja.label}</span>}
                      {c.cover ? <img src={c.cover} width={COVER_W} height={COVER_H} alt="" loading="lazy" decoding="async" /> : <span class="sin-portada">{item.name}</span>}
                    </span>
                    <span class="t">{item.name}</span>
                    {c.sub.length > 0 && <span class="s">{c.sub.map((x) => <span>{x}</span>)}</span>}
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </section>)}

    <section class="todos" id="todos">
      <details class="filtros" open>
        <summary>{t(lang, "ctl.filters")}</summary>
        <div class="filtros-cab">
          <b>{t(lang, "ctl.filters")}</b>
          <button class="limpiar" type="button" id="limpiar" hidden>{t(lang, "ctl.clear")}</button>
        </div>
        {
          typeFilter && types.length > 1 && (
            <fieldset class="grupo">
              <legend>{t(lang, "ctl.gType")}</legend>
              {types.map((c) => (
                <label><input type="checkbox" data-group="type" value={c.key} /><span class="sw punto" style={`--c:${c.color}`} /><span class="nm">{c.label}</span><span class="ct">{c.n}</span></label>
              ))}
            </fieldset>
          )
        }
        {
          consoles.length > 1 && (
            <fieldset class="grupo">
              <legend>{t(lang, "ctl.gConsole")}</legend>
              {consolasAZ.map((c) => (
                <label><input type="checkbox" data-group="console" value={c.key} /><span class="sw" style={`--c:${c.color}`} /><span class="nm">{c.label}</span><span class="ct">{c.n}</span></label>
              ))}
            </fieldset>
          )
        }
        {
          showStatus && (
            <fieldset class="grupo">
              <legend>{t(lang, "ctl.gStatus")}</legend>
              {statusOptions.map((s) => (
                <label><input type="checkbox" data-group="status" value={s} /><span class="nm">{STATUS_LABEL[s]}</span><span class="ct">{items.filter((i) => i.statusKey === s).length}</span></label>
              ))}
              {hasAbandoned && <label><input type="checkbox" data-group="status" value="__abandoned" /><span class="nm">{t(lang, "status.abandoned")}</span><span class="ct">{items.filter((i) => i.abandoned).length}</span></label>}
              {hasTakedown && <label><input type="checkbox" data-group="status" value="__takedown" /><span class="nm">{t(lang, "status.takedown")}</span><span class="ct">{items.filter((i) => i.takedown).length}</span></label>}
            </fieldset>
          )
        }
        {
          nInstalables > 0 && (
            <fieldset class="grupo">
              <legend>Unricopie</legend>
              <label><input type="checkbox" data-group="uc" value="1" /><span class="nm">{t(lang, "ctl.optInstallable")}</span><span class="ct">{nInstalables}</span></label>
            </fieldset>
          )
        }
      </details>

      <div class="resultados">
        <div class="res-barra">
          {!lista && <button class="volver" type="button" id="volver">{t(lang, "ctl.back")}</button>}
          <div class="meta" id="count" data-tmpl={countTmpl}>{countTmpl.replace("{shown}", String(ordered.length)).replace("{total}", String(ordered.length))}</div>
          <label class="orden">{t(lang, "ctl.sort")}
            <select id="sort">
              <option value="stars">{t(lang, "ctl.byStars")}</option>
              <option value="name">{t(lang, "ctl.byName")}</option>
              <option value="updated">{t(lang, "ctl.byUpdated")}</option>
            </select>
          </label>
        </div>
        <section class="grid" id="grid">
          {ordered.map((item) => <Card item={item} lang={lang} />)}
          {/* Callejón sin salida hasta ahora: este buscador solo filtra la sección
              actual, así que buscar "Jak" o "Strikers" en la home daba cero (están
              en ports) y la gente concluía que faltaban del catálogo. Dos quejas de
              r/recomps venían de aquí. Ahora el vacío ofrece el buscador global. */}
          <div class="empty" id="empty" style="display:none">
            <p>{t(lang, "empty.recomps")}</p>
            <button class="btn" type="button" id="empty-global">{t(lang, "empty.tryGlobal")}</button>
          </div>
        </section>
      </div>
    </section>

    {/* Al final de la lista, que es donde uno se da cuenta de que falta algo.
        Hasta ahora la invitación solo estaba en /contribuir y en las fichas,
        no en las cuatro páginas donde la gente recorre el catálogo. */}
    <aside class="addcta">
      <p>{t(lang, "cta.missing")}</p>
      <a class="btn" href={localePath(lang, "contribuir")}>{t(lang, "cta.add")}</a>
    </aside>
  </main>
</Base>

<script>
  // Filtro del catálogo. Script de módulo (deferido) → el DOM ya está listo.
  const grid = document.getElementById("grid");
  if (grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>("[data-card]"));
    const emptyEl = document.getElementById("empty")!;
    const countEl = document.getElementById("count")!;
    const tmpl = countEl.dataset.tmpl || "{shown} / {total}";
    const qEl = document.getElementById("q") as HTMLInputElement | null;
    const sortEl = document.getElementById("sort") as HTMLSelectElement | null;
    const explorarEl = document.getElementById("explorar")!;
    const todosEl = document.getElementById("todos")!;
    const limpiarEl = document.getElementById("limpiar");
    const boxes = Array.from(document.querySelectorAll<HTMLInputElement>(".filtros input[data-group]"));
    const state = { q: "", sort: "" };
    const todasHerramientas = cards.length > 0 && cards.every((c) => c.dataset.type === "tool");
    // Lo marcado en cada grupo: dentro de un grupo vale cualquiera; entre grupos, todos.
    const marcados = () => {
      const m: Record<string, Set<string>> = { type: new Set(), console: new Set(), status: new Set(), uc: new Set() };
      for (const b of boxes) if (b.checked) m[b.dataset.group || ""]?.add(b.value);
      return m;
    };

    const matches = (c: HTMLElement, m: Record<string, Set<string>>) => {
      if (m.type.size && !m.type.has(c.dataset.type || "")) return false;
      if (m.status.size) {
        const ok = (m.status.has("__abandoned") && c.dataset.abandoned === "true") || (m.status.has("__takedown") && c.dataset.takedown === "true") || m.status.has(c.dataset.status || "");
        if (!ok) return false;
      }
      if (m.console.size) {
        const cs = (c.dataset.consoles || "").split(",").filter(Boolean);
        if (!cs.some((x) => m.console.has(x))) return false;
      }
      if (m.uc.size && c.dataset.uc !== "1") return false;
      if (state.q && !(c.dataset.search || "").includes(state.q)) return false;
      return true;
    };

    // «Ver todos» deja #todos en la dirección: así se puede compartir y volver con «Atrás».
    const vista = (v: "inicio" | "todos") => {
      explorarEl.dataset.vista = v;
      const u = new URL(window.location.href);
      u.hash = v === "todos" ? "todos" : "";
      window.history.replaceState(null, "", u);
      if (v === "todos") todosEl.scrollIntoView({ block: "start" });
      else window.scrollTo({ top: 0 });
    };

    const apply = () => {
      const m = marcados();
      if (limpiarEl) limpiarEl.hidden = !boxes.some((b) => b.checked);
      let shown = 0;
      for (const c of cards) {
        const ok = matches(c, m);
        c.classList.toggle("hidden", !ok);
        if (ok) shown++;
      }
      // El orden: el elegido o el de la página; Unricopie primera si la lista es solo de launchers
      // y herramientas. Se recoloca todo (también lo oculto) para que, al quitar el filtro, cada
      // tarjeta vuelva a su sitio.
      let orden = cards;
      if (state.sort) {
        orden = [...cards].sort((a, b) => {
          if (state.sort === "name") return (a.dataset.name || "").localeCompare(b.dataset.name || "");
          if (state.sort === "updated") return (b.dataset.updated || "").localeCompare(a.dataset.updated || "");
          return Number(b.dataset.stars) - Number(a.dataset.stars) || (a.dataset.name || "").localeCompare(b.dataset.name || "");
        });
      }
      if (todasHerramientas || (m.type.size === 1 && m.type.has("tool"))) {
        orden = [...orden.filter((c) => c.dataset.ours === "1"), ...orden.filter((c) => c.dataset.ours !== "1")];
      }
      for (const c of orden) grid.appendChild(c);
      grid.appendChild(emptyEl);
      countEl.textContent = tmpl.replace("{shown}", String(shown)).replace("{total}", String(cards.length));
      emptyEl.style.display = shown ? "none" : "";
    };

    const syncUrl = () => {
      const u = new URL(window.location.href);
      if (state.q) u.searchParams.set("q", state.q);
      else u.searchParams.delete("q");
      window.history.replaceState(null, "", u);
    };

    // Buscar lleva a «Ver todos».
    qEl?.addEventListener("input", (e) => {
      state.q = (e.target as HTMLInputElement).value.trim().toLowerCase();
      syncUrl();
      apply();
      if (state.q && explorarEl.dataset.vista !== "todos") vista("todos");
    });
    sortEl?.addEventListener("change", (e) => { state.sort = (e.target as HTMLSelectElement).value; apply(); });
    for (const b of boxes) b.addEventListener("change", apply);
    limpiarEl?.addEventListener("click", () => { for (const b of boxes) b.checked = false; apply(); });
    // «Ver todos ›» de un estante: la cuadrícula con su filtro marcado (o su orden).
    for (const btn of document.querySelectorAll<HTMLButtonElement>(".ver-todos")) {
      btn.addEventListener("click", () => {
        for (const b of boxes) b.checked = !!btn.dataset.group && b.dataset.group === btn.dataset.group && b.value === btn.dataset.value;
        if (btn.dataset.sort && sortEl) { sortEl.value = btn.dataset.sort; state.sort = btn.dataset.sort; }
        apply();
        vista("todos");
      });
    }
    document.getElementById("volver")?.addEventListener("click", () => vista("inicio"));
    // En el móvil, los filtros empiezan plegados.
    const det = document.querySelector<HTMLDetailsElement>("details.filtros");
    if (det && window.matchMedia("(max-width: 860px)").matches) det.open = false;

    // deep-link: /?q=mario  → prefiltra y abre «Ver todos»
    const q0 = new URLSearchParams(window.location.search).get("q");
    if (q0 && qEl) { qEl.value = q0; state.q = q0.trim().toLowerCase(); explorarEl.dataset.vista = "todos"; }
    if (window.location.hash === "#todos") explorarEl.dataset.vista = "todos";
    apply();

    // Desde el vacío, saltar al buscador global llevándose lo que ya escribió.
    document.getElementById("empty-global")?.addEventListener("click", () => {
      const gi = document.getElementById("search-input") as HTMLInputElement | null;
      document.getElementById("search-open")?.click();
      if (gi && state.q) {
        gi.value = state.q;
        gi.dispatchEvent(new Event("input", { bubbles: true }));
      }
    });
  }
</script>
