---
import Base from "../../layouts/Base.astro";
import { getAllItems } from "../../lib/catalog";
import { coverOf, COVER_W, COVER_H } from "../../lib/games";
import { consoleMeta, inkOn } from "../../lib/consoles";
import instalables from "../../data/unricopie.json";
import publicada from "../../data/unricopie-version.json";
import { localePath, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}
// La página del launcher: qué hace, qué juegos instala y la descarga. Solo cuenta lo
// que la versión publicada hace de verdad. Hasta el lanzamiento, la descarga dice
// «Muy pronto»; el día que salga, src/data/unricopie-version.json dice la versión y su página
// (de ahí sale también /unricopie/version.json, con el que el launcher avisa).
const RELEASE: string | null = publicada.version ? publicada.pagina : null;

const { lang } = Astro.props;
const ids = new Set((instalables as { instalables: string[] }).instalables);
const coleccion = (type: string) => (type === "decomp" ? "decomps" : `${type}s`);
const juegos = (await getAllItems(lang))
  .filter((i) => ids.has(`${coleccion(i.type)}/${i.id}`))
  .map((i) => {
    const g = i.games.find((x) => coverOf(x));
    const cm = i.consoleKeys[0] ? consoleMeta(i.consoleKeys[0], lang) : null;
    return { href: i.href, name: i.name, cover: g ? coverOf(g) : null, cm };
  })
  .sort((a, b) => a.name.localeCompare(b.name, lang));

const T = {
  es: {
    title: "Unricopie, el launcher de Recompendium",
    description: "Instala los proyectos del catálogo desde su versión oficial, comprueba tu copia del juego y lo deja listo para jugar.",
    lead: "Instala los proyectos del catálogo desde su versión oficial, comprueba tu copia del juego y lo deja listo para jugar. Es gratis y de código abierto.",
    soon: "Muy pronto",
    windows: "Windows (64 bits)",
    linux: "Linux (AppImage)",
    whatH: "Qué hace",
    what: [
      ["Instala desde la fuente", "Baja cada proyecto de la versión que publica su autor y comprueba la descarga con la suma que da GitHub. Nunca reparte juegos ni compila versiones propias."],
      ["Comprueba tu copia", "Compara tu copia del juego con las versiones que pide cada proyecto y la deja donde el juego la busca. Tu copia queda guardada una sola vez y no se toca."],
      ["Tres canales", "Estable, lo que probamos nosotros; sin probar, la última versión oficial; y nightly, lo último que publica el proyecto."],
      ["Actualiza sin miedo", "Guarda la versión anterior con tus partidas y ajustes, y te deja volver atrás."],
      ["Mods con orden", "Mods de Thunderstore con perfiles, orden de carga y aviso de conflictos, para Zelda 64: Recompiled y Banjo: Recompiled."],
      ["Portable", "Si quieres, todo en una sola carpeta: el launcher, los juegos, las partidas y los ajustes."],
    ],
    gamesH: "Qué juegos instala",
    gamesLead: (n: number) => `${n} proyectos del catálogo, por ahora. Sumamos más cada semana; los demás siguen en el catálogo con su enlace al proyecto.`,
    reqH: "Requisitos",
    req: "Windows 10 u 11 de 64 bits, o Linux x86-64. No pide cuenta. El código es libre (GPL-3.0); las recetas que dicen cómo instalar cada juego son nuestras y se actualizan solas.",
  },
  en: {
    title: "Unricopie, the Recompendium launcher",
    description: "Installs catalog projects from their official release, checks your copy of the game, and gets it ready to play.",
    lead: "Installs catalog projects from their official release, checks your copy of the game, and gets it ready to play. It’s free and open source.",
    soon: "Coming soon",
    windows: "Windows (64-bit)",
    linux: "Linux (AppImage)",
    whatH: "What it does",
    what: [
      ["Installs from the source", "Downloads each project from the release its author publishes and checks the download against GitHub’s checksum. It never ships games or builds its own versions."],
      ["Checks your copy", "Compares your copy of the game with the versions each project asks for and puts it where the game looks for it. Your copy is stored once and never touched."],
      ["Three channels", "Stable, what we tested; untested, the latest official release; and nightly, the newest the project publishes."],
      ["Updates safely", "Keeps the previous version with your saves and settings, and lets you roll back."],
      ["Mods in order", "Thunderstore mods with profiles, load order, and conflict warnings, for Zelda 64: Recompiled and Banjo: Recompiled."],
      ["Portable", "If you want, everything in one folder: the launcher, the games, the saves, and the settings."],
    ],
    gamesH: "What it installs",
    gamesLead: (n: number) => `${n} catalog projects for now. We add more every week; the rest stay in the catalog with their link to the project.`,
    reqH: "Requirements",
    req: "64-bit Windows 10 or 11, or x86-64 Linux. No account needed. The code is free software (GPL-3.0); the recipes that say how to install each game are ours and update on their own.",
  },
}[lang];
---

<Base lang={lang} title={`${T.title} — Recompendium`} description={T.description}>
  <main class="wrap unricopie">
    <div class="u-hero">
      <img class="u-pie" src="/pastel.svg" alt="" width="96" height="96" />
      <div>
        <h1>Unricopie</h1>
        <p class="lead">{T.lead}</p>
        <div class="u-descargas">
          {
            RELEASE ? (
              <>
                <a class="instalar" href={RELEASE}>{T.windows}</a>
                <a class="btn" href={RELEASE}>{T.linux}</a>
              </>
            ) : (
              <span class="instalar is-off" aria-disabled="true">{T.soon}</span>
            )
          }
        </div>
      </div>
    </div>

    <h2 class="h">{T.whatH}</h2>
    <div class="u-que">
      {T.what.map(([h, p]) => (<div><h3>{h}</h3><p>{p}</p></div>))}
    </div>

    <h2 class="h">{T.gamesH} <small>{juegos.length}</small></h2>
    <p class="u-nota">{T.gamesLead(juegos.length)}</p>
    <ul class="estante">
      {
        juegos.map((j) => (
          <li>
            <a class="caja-j" href={j.href}>
              <span class="caja" style={j.cm ? `--c:${j.cm.color};--ci:${inkOn(j.cm.color)}` : undefined}>
                {j.cm && <span class="franja">{j.cm.tag}</span>}
                {j.cover ? <img src={j.cover} width={COVER_W} height={COVER_H} alt="" loading="lazy" decoding="async" /> : <span class="sin-portada">{j.name}</span>}
              </span>
              <span class="t">{j.name}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <h2 class="h">{T.reqH}</h2>
    <p class="u-nota">{T.req}</p>
  </main>
</Base>
