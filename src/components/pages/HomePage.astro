---
import CatalogView from "./CatalogView.astro";
import { getAllItems } from "../../lib/catalog";
import { t, localePath, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
// El Catálogo es TODO: las cuatro colecciones en una sola lista, con el filtro
// de tipo para acotar. Antes era solo recomps, y eso engañaba: el menú decía
// "Catálogo", el contador decía "129 de 129 proyectos" habiendo 336, y buscar
// "Jak" o "Strikers" aquí daba cero porque viven en ports. Los recomps tienen
// ahora su propia página, como ports, decomps y herramientas.
const items = await getAllItems(lang);

const consoles = new Set<string>();
for (const i of items) for (const c of i.consoleKeys) consoles.add(c);
const stats = [
  { n: items.filter((i) => i.type === "recomp").length, label: t(lang, "home.stat.recomps") },
  { n: items.filter((i) => i.type === "port").length, label: t(lang, "home.stat.ports") },
  { n: items.filter((i) => i.type === "decomp").length, label: t(lang, "home.stat.decomps") },
  { n: items.filter((i) => i.type === "tool").length, label: t(lang, "home.stat.tools") },
  { n: consoles.size, label: t(lang, "home.stat.platforms") },
];
---

<CatalogView
  lang={lang}
  items={items}
  h1={`<img class="hero-wordmark" src="${localePath("es", "recompendium-wordmark.svg")}" alt="Recompendium" />`}
  tagline={t(lang, "home.tagline")}
  countTmpl={t(lang, "count.of")}
  guide
  typeFilter
  stats={stats}
/>
