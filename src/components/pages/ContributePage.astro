---
import Base from "../../layouts/Base.astro";
import ProjectForm from "../ProjectForm.astro";
import { type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const es = lang === "es";

const txt = es
  ? {
      title: "Contribuir — Recompendium",
      h1: "Contribuir",
      lead: "¿Falta una recompilación, un port, una decompilación o una herramienta? Completa el formulario y envíalo: se abre un issue en GitHub con tu propuesta y, cuando la aprobamos, aparece en el sitio. Basta con escribirla en tu idioma; de la otra versión nos encargamos nosotros.",
    }
  : {
      title: "Contribute — Recompendium",
      h1: "Contribute",
      lead: "Missing a recompilation, a port, a decompilation, or a tool? Fill in the form and submit it: an issue opens on GitHub with your proposal, and once we approve it, it appears on the site. You only need to write it in your language; we’ll take care of the other version.",
    };
---

<Base lang={lang} title={txt.title} description={txt.lead}>
  <main class="wrap detail">
    <h1>{txt.h1}</h1>
    <p class="lead" style="max-width:64ch">{txt.lead}</p>
    <div style="margin-top:24px"><ProjectForm lang={lang} mode="new" /></div>
  </main>
</Base>
