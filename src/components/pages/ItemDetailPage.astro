---
import { getEntry, getCollection, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Card from "../Card.astro";
import ProjectForm from "../ProjectForm.astro";
import { consoleMeta, inkOn } from "../../lib/consoles";
import { statusMeta, toolKindMeta, toolStatusMeta, modKindMeta, stalledDays, STALLED_COLOR } from "../../lib/status";
import { statFor, fmtStars, fmtDate, relDate, repoUrlOf } from "../../lib/stats";
import { toolRelated, CAT_COLOR, type Item, type ItemType } from "../../lib/catalog";
import { tagLabel } from "../../lib/tags";
import { t, localePath, type Lang } from "../../i18n";
import { consolePageKeys } from "../../lib/console-pages";
import { getGames, gamePageIds, projectsByGame, installedBy, coverOf, COVER_W, COVER_H } from "../../lib/games";
import instalables from "../../data/unricopie.json";

interface Props {
  lang: Lang;
  type: ItemType;
  entry:
    | CollectionEntry<"recomps">
    | CollectionEntry<"tools">
    | CollectionEntry<"ports">
    | CollectionEntry<"decomps">
    | CollectionEntry<"mods">;
}
const { lang, type, entry } = Astro.props;
const d: any = entry.data;
const s = d.enrich === false ? {} : statFor(d.repo);
const ownerName: string = (d.author ?? (typeof d.repo === "string" ? d.repo.split("/")[0] : "—"))
  + (d.authorFormerly ? ` (${t(lang, "detail.fact.formerly", { name: d.authorFormerly })})` : "");
const decompPct: number | null = d.decomp ? statFor(d.decomp).decompPercent ?? null : null;

// Mismo aviso de "parado" que en las tarjetas, con la regla unica de status.ts:
// quien aterriza directo en la ficha debe verlo igual que quien la ve en la lista.
const stalled = stalledDays({
  type,
  status: d.status,
  pushedAt: (s as { pushedAt?: string }).pushedAt,
  decompPercent: decompPct ?? (s as { decompPercent?: number }).decompPercent,
  abandoned: d.abandoned,
});
const stalledPill = (() => {
  if (stalled == null) return null;
  const meses = Math.floor(stalled / 30);
  if (meses < 12) return t(lang, "status.stalledMonths", { n: meses });
  const anos = Math.floor(stalled / 365);
  return anos === 1 ? t(lang, "status.stalledYear") : t(lang, "status.stalledYears", { n: anos });
})();

let crumb: { label: string; href: string };
let badgeLabel: string, badgeColor: string;
let statusLabel: string | null = null, statusColor = "";
const facts: { dt: string; dd: string; href?: string }[] = [];
// La consola enlaza a su página (/consola/<clave>/), si la tiene.
const consolePages = await consolePageKeys();
const consoleHref = (k?: string) => (k && consolePages.includes(k) ? localePath(lang, `consola/${k}`) : undefined);
let related: { items: Item[]; titleKey: string } | null = null;
let installsNote: string | null = null;

// Juego o juegos de la ficha, con enlace a su página si la tienen, y el resto
// de proyectos de cada juego con página («Otros proyectos de X»).
const gamesMap = await getGames();
const withPage = new Set(await gamePageIds());
const byGame = await projectsByGame(lang);
const myGames = ((d.games ?? []) as string[]).map((g) => gamesMap.get(g)).filter((g) => g != null);
const gameLinks = myGames.map((g) => ({
  label: g.name,
  meta: [g.platforms.filter((p) => p !== "other").map((p) => consoleMeta(p, lang).label)[0], g.year].filter(Boolean).join(", "),
  href: withPage.has(g.id) ? localePath(lang, `juego/${g.id}`) : undefined,
}));
// Portada del (primer) juego de la ficha, con enlace a su página si la tiene.
const coverGame = myGames.find((g) => coverOf(g.id));
const cover = coverGame ? { src: coverOf(coverGame.id)!, name: coverGame.name, href: withPage.has(coverGame.id) ? localePath(lang, `juego/${coverGame.id}`) : undefined } : null;
const otherProjects = myGames
  .filter((g) => withPage.has(g.id))
  .map((g) => ({
    name: g.name,
    href: localePath(lang, `juego/${g.id}`),
    items: (byGame.get(g.id) ?? []).filter((i) => !(i.type === type && i.id === entry.id)),
  }))
  .filter((o) => o.items.length > 0);
// Ficha del catálogo sobre la que se monta un mod ("ports/perfect-dark").
let base: { label: string; href: string } | null = null;
// Port ↔ decompilación: el campo `decomp` de un port es el repo de su
// decompilación; si esa decompilación tiene ficha, se enlazan en los dos sentidos.
let fromDecomp: { label: string; href: string } | null = null;
let portsOfDecomp: { label: string; href: string }[] = [];

if (type === "recomp") {
  // `type` discrimina qué colección llega; estrechamos para que las claves
  // dinámicas de i18n (`status.${...}`) resuelvan a claves reales del diccionario.
  const dr = entry.data as CollectionEntry<"recomps">["data"];
  const cm = consoleMeta(dr.console, lang), sm = statusMeta(dr.status);
  crumb = { label: t(lang, "detail.crumbCatalog"), href: localePath(lang, "") };
  badgeLabel = cm.label; badgeColor = cm.color;
  statusLabel = t(lang, `status.${dr.status}`); statusColor = sm.color;
  facts.push({ dt: t(lang, "detail.fact.method"), dd: t(lang, "method.recomp") });
  facts.push({ dt: t(lang, "detail.fact.console"), dd: cm.full, href: consoleHref(dr.console) });
  facts.push({ dt: t(lang, "detail.fact.arch"), dd: cm.arch });
  facts.push({ dt: t(lang, "detail.fact.author"), dd: ownerName });
  if (d.originalDeveloper) facts.push({ dt: t(lang, "detail.fact.origDev"), dd: d.originalDeveloper });
  if (d.year) facts.push({ dt: t(lang, "detail.fact.year"), dd: String(d.year) });
} else if (type === "tool") {
  const dl = entry.data as CollectionEntry<"tools">["data"];
  const km = toolKindMeta(dl.kind), ts = toolStatusMeta(dl.status);
  crumb = { label: t(lang, "detail.crumbLaunchers"), href: localePath(lang, "launchers") };
  badgeLabel = t(lang, `toolkind.${dl.kind}`); badgeColor = km.color;
  if (ts && dl.status) { statusLabel = t(lang, `toolstatus.${dl.status}`); statusColor = ts.color; }
  facts.push({ dt: t(lang, "detail.fact.kind"), dd: t(lang, `toolkind.${dl.kind}`) });
  if (d.consoles?.length) facts.push({ dt: t(lang, "detail.fact.consoles"), dd: d.consoles.map((c: string) => consoleMeta(c, lang).label).join(" · ") });
  facts.push({ dt: t(lang, "detail.fact.author"), dd: ownerName });
  // Un launcher que publica su lista muestra lo que instala de verdad; si no
  // la publica, los recomps de sus plataformas, como hasta ahora.
  const inst = dl.kind === "launcher" ? await installedBy(entry.id, lang) : null;
  if (inst && inst.items.length) {
    related = { items: inst.items, titleKey: "detail.relatedInstalls" };
    if (inst.checkedAt) installsNote = t(lang, "detail.installsNote", { date: fmtDate(inst.checkedAt) });
  } else {
    related = await toolRelated(entry as CollectionEntry<"tools">, lang);
  }
} else if (type === "port") {
  const dp = entry.data as CollectionEntry<"ports">["data"];
  const cm = dp.console ? consoleMeta(dp.console, lang) : null, sm = statusMeta(dp.status);
  crumb = { label: t(lang, "detail.crumbPorts"), href: localePath(lang, "ports") };
  badgeLabel = t(lang, `category.${dp.category}`); badgeColor = CAT_COLOR[dp.category] ?? "#9AA0B5";
  statusLabel = t(lang, `status.${dp.status}`); statusColor = sm.color;
  facts.push({ dt: t(lang, "detail.fact.method"), dd: t(lang, `method.${dp.category}`) });
  if (dp.decomp) {
    const de = (await getCollection("decomps")).find((x) => x.data.repo?.toLowerCase() === dp.decomp!.toLowerCase());
    if (de) fromDecomp = { label: de.data.name, href: localePath(lang, `decomp/${de.id}`) };
  }
  if (cm) facts.push({ dt: t(lang, "detail.fact.console"), dd: cm.full, href: consoleHref(dp.console) });
  if (d.engine) facts.push({ dt: t(lang, "detail.fact.engine"), dd: d.engine });
  if (d.originalDeveloper) facts.push({ dt: t(lang, "detail.fact.origDev"), dd: d.originalDeveloper });
  if (d.year) facts.push({ dt: t(lang, "detail.fact.year"), dd: String(d.year) });
  facts.push({ dt: t(lang, "detail.fact.author"), dd: ownerName });
} else if (type === "mod") {
  const dm = entry.data as CollectionEntry<"mods">["data"];
  const cm = consoleMeta(dm.console, lang), mk = modKindMeta(dm.kind), ts = toolStatusMeta(dm.status);
  crumb = { label: t(lang, "detail.crumbMods"), href: localePath(lang, "mods") };
  badgeLabel = t(lang, `modkind.${dm.kind}`); badgeColor = mk.color;
  if (ts && dm.status) { statusLabel = t(lang, `toolstatus.${dm.status}`); statusColor = ts.color; }
  facts.push({ dt: t(lang, "detail.fact.kind"), dd: badgeLabel });
  facts.push({ dt: t(lang, "detail.fact.game"), dd: dm.game[lang] });
  facts.push({ dt: t(lang, "detail.fact.platform"), dd: cm.full, href: consoleHref(dm.console) });
  facts.push({ dt: t(lang, "detail.fact.author"), dd: ownerName });
  if (dm.base) {
    const [col, id] = dm.base.split("/") as ["recomps" | "ports" | "decomps" | "tools", string];
    const be = await getEntry(col, id);
    const ruta = { recomps: "recomp", ports: "port", decomps: "decomp", tools: "tool" }[col];
    if (be) base = { label: be.data.name, href: localePath(lang, `${ruta}/${id}`) };
  }
} else {
  const cm = consoleMeta(d.console, lang);
  crumb = { label: t(lang, "detail.crumbDecomps"), href: localePath(lang, "decompilaciones") };
  const repo = typeof d.repo === "string" ? d.repo.toLowerCase() : null;
  if (repo) portsOfDecomp = (await getCollection("ports"))
    .filter((p) => p.data.decomp?.toLowerCase() === repo)
    .map((p) => ({ label: p.data.name, href: localePath(lang, `port/${p.id}`) }));
  badgeLabel = cm.label; badgeColor = cm.color;
  facts.push({ dt: t(lang, "detail.fact.console"), dd: cm.full, href: consoleHref(d.console) });
  facts.push({ dt: t(lang, "detail.fact.arch"), dd: cm.arch });
  facts.push({ dt: t(lang, "detail.fact.author"), dd: ownerName });
}
// Sin datos del bot (fichas nuevas, o enrich: false) no se muestran: un "—" no dice nada.
if (s.stars != null) facts.push({ dt: t(lang, "detail.fact.stars"), dd: fmtStars(s.stars) });
if (s.pushedAt) facts.push({ dt: t(lang, "detail.fact.lastPush"), dd: `${fmtDate(s.pushedAt)} · ${relDate(s.pushedAt, lang)}` });
if (decompPct != null) facts.push({ dt: t(lang, "detail.fact.decomp"), dd: `${decompPct}%` });
if (s.version) facts.push({ dt: t(lang, "detail.fact.version"), dd: s.versionAt ? `${s.version} · ${fmtDate(s.versionAt)}` : s.version });
if (s.license) facts.push({ dt: t(lang, "detail.fact.license"), dd: s.license });
if (s.language) facts.push({ dt: t(lang, "detail.fact.lang"), dd: s.language });

const repoUrl = repoUrlOf(d);
// Ficha sin enlace: el repo se nombra como texto y no se enlaza en ningún sitio de la página.
const unlinked: boolean = !!d.unlinked && !d.takedown;
const unlinkedSlug: string | null = unlinked ? (d.repo ?? (repoUrl ? new URL(repoUrl).pathname.slice(1) : null)) : null;
const unlinkedHost: string = repoUrl && !d.repo ? (new URL(repoUrl).hostname.includes("gitlab") ? "GitLab" : new URL(repoUrl).hostname) : "GitHub";
const homepage: string | undefined = d.homepage;
const forkOf = d.forkOf ?? (s.fork ? { label: s.fork, url: `https://github.com/${s.fork}` } : null);
const dataDir = type === "recomp" ? "recomps" : type === "tool" ? "tools" : type === "port" ? "ports" : type === "mod" ? "mods" : "decomps";
const dataPath = `src/data/${dataDir}/${entry.id}.yaml`;

const tags: string[] = d.tags ?? [];
const links: { label: { es: string; en: string }; url: string }[] = d.links ?? [];
const progress: number | null = type === "recomp" ? d.progress ?? null : null;
const barPct: number | null = progress ?? decompPct;
const barLabel: string = progress != null ? t(lang, "card.progress", { n: progress }) : decompPct != null ? t(lang, "card.decomp", { n: decompPct }) : "";

// Título para buscadores: el juego, «en PC» y cómo llega, que es lo que se busca.
const cLabel = (k?: string) => (k ? consoleMeta(k, lang).label : "");
const lower = (x: string) => x.charAt(0).toLowerCase() + x.slice(1);
const seoTitle =
  type === "recomp" ? t(lang, "seo.recomp", { name: d.name, console: cLabel(d.console) })
  : type === "port" ? (d.console
      ? t(lang, "seo.port", { name: d.name, method: lower(t(lang, `method.${d.category}` as any)), console: cLabel(d.console) })
      : t(lang, "seo.portNoConsole", { name: d.name, method: lower(t(lang, `method.${d.category}` as any)) }))
  : type === "decomp" ? t(lang, "seo.decomp", { name: d.name, console: cLabel(d.console) })
  : type === "tool" ? t(lang, "seo.tool", { name: d.name, kind: lower(t(lang, `toolkind.${d.kind}` as any)) })
  // Mods: el juego solo si es corto (algunos son listas largas, como los de Melty).
  : d.game[lang].length <= 40
    ? t(lang, "seo.mod", { name: d.name, kind: lower(t(lang, `modkind.${d.kind}` as any)), game: d.game[lang] })
    : t(lang, "seo.tool", { name: d.name, kind: lower(t(lang, `modkind.${d.kind}` as any)) });

// Datos estructurados: el proyecto (código fuente) y el juego del que trata.
const abs = (p: string) => (Astro.site ? new URL(p.endsWith("/") ? p : p + "/", Astro.site).href : p);
// Diseño v3: la franja de la consola y el botón dorado si Unricopie sabe instalar esta ficha.
const fKey: string | undefined = type === "tool" ? undefined : d.console;
const fcm = fKey ? consoleMeta(fKey, lang) : null;
const franjaStyle = fcm ? `--c:${fcm.color};--ci:${inkOn(fcm.color)}` : undefined;
const franjaOrigen = [d.originalDeveloper, d.year].filter(Boolean).join(", ");
const instalable = (instalables as { instalables: string[] }).instalables.includes(`${type === "decomp" ? "decomps" : type + "s"}/${entry.id}`);
// Insignia para el README del proyecto: enlaza a la ficha en inglés, el idioma de casi todos los README.
const badgeUrl = Astro.site ? new URL(`insignias/${type}/${entry.id}.svg`, Astro.site).href : `/insignias/${type}/${entry.id}.svg`;
const badgeMd = `[![Recompendium](${badgeUrl})](${abs(localePath("en", `${type}/${entry.id}`))})`;
const consoleKey: string | undefined = type === "tool" ? undefined : d.console;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    name: d.name,
    description: d.desc[lang],
    url: abs(Astro.url.pathname),
    inLanguage: lang,
    codeRepository: unlinked ? undefined : repoUrl || undefined,
    programmingLanguage: s.language || undefined,
    license: s.license || undefined,
    about: type === "tool" ? undefined : {
      "@type": "VideoGame",
      name: type === "mod" ? d.game[lang] : d.name,
      gamePlatform: consoleKey ? consoleMeta(consoleKey, lang).full : undefined,
      datePublished: d.year ? String(d.year) : undefined,
      author: d.originalDeveloper ? { "@type": "Organization", name: d.originalDeveloper } : undefined,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Recompendium", item: abs(localePath(lang, "")) },
      { "@type": "ListItem", position: 2, name: crumb.label.replace(/^[^\p{L}\p{N}]+/u, ""), item: abs(crumb.href) },
      { "@type": "ListItem", position: 3, name: d.name, item: abs(Astro.url.pathname) },
    ],
  },
];
---

<Base lang={lang} title={`${seoTitle} — Recompendium`} description={d.desc[lang]} jsonLd={jsonLd}>
  <main class="v3">
    {fcm && (<div class="cfranja" style={franjaStyle}><div class="wrap"><span>{fcm.full}</span>{franjaOrigen && <span>{franjaOrigen}</span>}</div></div>)}
    <div class="wrap web">
    <div class="izq">
    <div class="crumb"><a href={crumb.href}>{crumb.label}</a></div>

    <div>
    <div class="detail-top">
      <span class="console" style={`--rail:${badgeColor};color:${badgeColor}`}><span class="dot"></span>{badgeLabel}</span>
      {statusLabel && <span class="pill is-pill" style={`color:${statusColor}`}>{statusLabel}</span>}
      {stalledPill && (
        <span class="pill is-pill" style={`color:${STALLED_COLOR}`} title={t(lang, "status.stalledHelp", { n: Math.floor(stalled! / 30) })}>{stalledPill}</span>
      )}
      {d.abandoned && <span class="pill is-pill" style="color:#8b93a7">{t(lang, "status.abandoned")}</span>}
      {d.takedown && <span class="pill is-pill" style="color:#e05656">{t(lang, "status.takedown")}</span>}
      {unlinked && <span class="pill is-pill" style="color:#e0a93a">{t(lang, "status.unlinked")}</span>}
    </div>

    {base && (<p class="forkline"><a href={base.href}>{t(lang, "detail.fact.base")}: {base.label}</a></p>)}
    {fromDecomp && (<p class="forkline"><a href={fromDecomp.href}>{t(lang, "detail.basedOnDecomp")}: {fromDecomp.label}</a></p>)}
    {portsOfDecomp.length > 0 && (
      <p class="forkline">{t(lang, "detail.portsOfDecomp")}: {portsOfDecomp.map((p, i) => (<>{i > 0 && " · "}<a href={p.href}>{p.label}</a></>))}</p>
    )}
    {forkOf && !unlinked && (<p class="forkline"><a href={forkOf.url} target="_blank" rel="noopener">⑂ {t(lang, "detail.fork")} {forkOf.label} ↗</a></p>)}
    {forkOf && unlinked && (<p class="forkline">⑂ {t(lang, "detail.fork")} {forkOf.label}</p>)}

    <h1>{d.name}</h1>
    {
      gameLinks.length > 0 && (
        <p class="forkline game-line">
          {t(lang, gameLinks.length > 1 ? "detail.gamesLine" : "detail.gameLine")}:{" "}
          {gameLinks.map((g, i) => (<>{i > 0 && " · "}{g.href ? <a href={g.href}>{g.label} →</a> : g.label}{g.meta && ` (${g.meta})`}</>))}
        </p>
      )
    }
    </div>
    {
      (cover || (instalable && !d.takedown)) && (
        <div class="movil-accion">
          {cover && (<span class="caja-mini" style={franjaStyle}>{fcm && <span class="franja">{fcm.tag}</span>}<img src={cover.src} width={COVER_W} height={COVER_H} alt="" /></span>)}
          {instalable && !d.takedown && <a class="instalar" href={localePath(lang, "unricopie")}>{t(lang, "unricopie.install")}</a>}
        </div>
      )
    }
    <p class="lead">{d.desc[lang]}</p>

    {
      barPct != null && (
        <div class="prog" style={`--rail:${badgeColor};max-width:420px`}>
          <div class="bar"><i style={`width:${barPct}%`} /></div>
          <div class="lbl">{barLabel}</div>
        </div>
      )
    }

    {
      d.takedown && (
        <p class="reqs" style="max-width:70ch;border-left:2px solid #e05656;padding-left:12px">
          <span class="reqs-k" style="color:#e05656">{t(lang, "status.takedown")}</span>{t(lang, "detail.takedownNote")}
        </p>
      )
    }

    {
      unlinked && unlinkedSlug && (
        <p class="reqs" style="max-width:70ch;border-left:2px solid #e0a93a;padding-left:12px">
          <span class="reqs-k" style="color:#e0a93a">{t(lang, "status.unlinked")}</span>{t(lang, "detail.unlinkedNote", { host: unlinkedHost })} <code>{unlinkedSlug}</code>.
        </p>
      )
    }

    <div class="actions">
      {repoUrl && !d.takedown && !unlinked && <a class:list={["btn", { primary: !instalable }]} href={repoUrl} target="_blank" rel="noopener">{t(lang, "detail.viewRepo")}</a>}
      {homepage && !d.takedown && !unlinked && <a class="btn" href={homepage} target="_blank" rel="noopener">{t(lang, "detail.homepage")}</a>}
      {links.map((l) => <a class="btn" href={l.url} target="_blank" rel="noopener">{l.label[lang]} ↗</a>)}
      <button class="btn btn-edit" id="edit-toggle" type="button">{t(lang, "detail.edit")}</button>
    </div>

    <div class="edit-pane" id="edit-pane" hidden>
      <ProjectForm lang={lang} mode="edit" type={type} path={dataPath} data={d} />
    </div>

    {tags.length > 0 && (<div class="tagrow">{tags.map((tag) => <span class="tg">{tagLabel(tag, lang)}</span>)}</div>)}

    <details class="badge-box">
      <summary>{t(lang, "detail.badge")}</summary>
      <p>{t(lang, "detail.badgeHelp")}</p>
      <img src={`/insignias/${type}/${entry.id}.svg`} alt={t(lang, "detail.badge")} height="20" loading="lazy" />
      <pre><code id="badge-md">{badgeMd}</code></pre>
      <button class="btn" type="button" id="badge-copy" data-done={t(lang, "detail.badgeCopied")}>{t(lang, "detail.badgeCopy")}</button>
    </details>

    {
      otherProjects.map((o) => (
        <>
          <h2 class="h">{t(lang, "detail.otherProjects", { name: o.name })} <small>{o.items.length}</small></h2>
          <p class="game-links">
            {o.items.slice(0, 8).map((it, i) => (<>{i > 0 && " · "}<a href={it.href}>{it.name}</a></>))}
            {" "}<a class="see-all" href={o.href}>{t(lang, "detail.seeAll")}</a>
          </p>
        </>
      ))
    }

    {
      related && (
        <>
          <h2 class="h">{t(lang, related.titleKey as any)} <small>{related.items.length}</small></h2>
          {installsNote && <p class="game-meta">{installsNote}</p>}
          {related.items.length ? (
            <section class="grid" style="padding:0">{related.items.map((it) => <Card item={it} lang={lang} />)}</section>
          ) : (
            <p class="empty">{t(lang, "detail.relatedEmpty")}</p>
          )}
        </>
      )
    }
    </div>

    <aside class="der">
      {
        cover && (
          cover.href
            ? <a class="caja" style={franjaStyle} href={cover.href}>{fcm && <span class="franja">{fcm.label}</span>}<img src={cover.src} width={COVER_W} height={COVER_H} alt={t(lang, "game.coverAlt", { name: cover.name })} /></a>
            : <span class="caja" style={franjaStyle}>{fcm && <span class="franja">{fcm.label}</span>}<img src={cover.src} width={COVER_W} height={COVER_H} alt={t(lang, "game.coverAlt", { name: cover.name })} /></span>
        )
      }
      {instalable && !d.takedown && <a class="instalar" href={localePath(lang, "unricopie")}>{t(lang, "unricopie.install")}</a>}
      <dl class="dl">
        {facts.map((f) => (<><dt>{f.dt}</dt><dd>{f.href ? <a href={f.href}>{f.dd}</a> : f.dd}</dd></>))}
      </dl>
      {d.requirements && (<div class="necesitas"><b>{t(lang, "card.reqs")}</b> {d.requirements[lang]}</div>)}
    </aside>
    </div>
  </main>
</Base>

<script>
  const toggle = document.getElementById("edit-toggle");
  const pane = document.getElementById("edit-pane");
  toggle?.addEventListener("click", () => {
    if (!pane) return;
    pane.hidden = !pane.hidden;
    if (!pane.hidden) pane.scrollIntoView({ behavior: "smooth", block: "nearest" });
  });
  // Enlace directo .../recomp/<id>#edit abre el formulario al cargar.
  if (pane && location.hash === "#edit") pane.hidden = false;
  // Copiar el Markdown de la insignia.
  const copy = document.getElementById("badge-copy");
  copy?.addEventListener("click", async () => {
    const md = document.getElementById("badge-md")?.textContent ?? "";
    try {
      await navigator.clipboard.writeText(md);
      copy.textContent = copy.dataset.done ?? "✓";
    } catch {
      // Sin permiso para el portapapeles: el texto queda a la vista para copiarlo a mano.
    }
  });
</script>
