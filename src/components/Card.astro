---
import { t, type Lang } from "../i18n";
import { fmtStars, fmtDate } from "../lib/stats";
import { STALLED_COLOR } from "../lib/status";
import type { Item } from "../lib/catalog";
import { coverOf, COVER_W, COVER_H } from "../lib/games";
import { consoleMeta, inkOn } from "../lib/consoles";
import unricopie from "../data/unricopie.json";

interface Props {
  item: Item;
  lang: Lang;
}
const { item, lang } = Astro.props;
// La caja del diseño v3: la portada del juego con la franja de color de su consola.
const coverGame = item.games.find((g) => coverOf(g));
const cover = coverGame ? coverOf(coverGame) : null;
const cm = item.consoleKeys[0] ? consoleMeta(item.consoleKeys[0], lang) : null;
const franja = cm ? { label: cm.tag, color: cm.color, ink: inkOn(cm.color) } : null;
const repoFallback = item.type === "recomp" ? t(lang, "card.repoTBD") : "—";
// Se instala con Unricopie: para el filtro y el estante de Explorar.
const instalable = (unricopie as { instalables: string[] }).instalables.includes(`${item.type === "decomp" ? "decomps" : item.type + "s"}/${item.id}`) && !item.takedown;
// Solo mostramos estrellas/versión cuando hay datos en vivo (repo enriquecido).
const hasStats = item.stars != null;

// Aviso de "parado". En meses hasta el año, en años a partir de ahí: a los
// 1009 días de CannonBall nadie cuenta meses.
const stalledPill = (() => {
  if (item.stalledDays == null) return null;
  const meses = Math.floor(item.stalledDays / 30);
  if (meses < 12) return t(lang, "status.stalledMonths", { n: meses });
  const anos = Math.floor(item.stalledDays / 365);
  return anos === 1 ? t(lang, "status.stalledYear") : t(lang, "status.stalledYears", { n: anos });
})();
---

<a
  href={item.href}
  data-card
  data-type={item.type}
  data-status={item.statusKey}
  data-abandoned={item.abandoned ? "true" : "false"}
  data-takedown={item.takedown ? "true" : "false"}
  data-consoles={item.consoleKeys.join(",")}
  data-name={item.name.toLowerCase()}
  data-search={item.search}
  data-stars={item.stars ?? -1}
  data-updated={item.pushedAt ?? ""}
  data-stalled={item.stalledDays ?? ""}
  data-uc={instalable ? "1" : "0"}
  data-ours={item.ours ? "1" : undefined}
  style={`--rail:${item.railColor}`}
  class:list={["card", { "has-cover": cover }]}
  target={item.external ? "_blank" : undefined}
  rel={item.external ? "noopener" : undefined}
>
  <div class="card-head">
  {
    cover && (
      <span class="caja-mini" style={franja ? `--c:${franja.color};--ci:${franja.ink}` : undefined}>
        {franja && <span class="franja">{franja.label}</span>}
        <img src={cover} width={COVER_W} height={COVER_H} alt="" loading="lazy" decoding="async" />
      </span>
    )
  }
  <div class="card-head-txt">
  <div class="card-top">
    <span class="console"><span class="dot"></span>{item.kindLabel}</span>
    <span class="pills">
      {item.status && <span class="pill is-pill" style={`color:${item.status.color}`}>{item.status.label}</span>}
      {item.abandoned && <span class="pill is-pill" style="color:#8b93a7">{t(lang, "status.abandoned")}</span>}
      {item.takedown && <span class="pill is-pill" style="color:#e05656">{t(lang, "status.takedown")}</span>}
      {stalledPill && (
        <span class="pill is-pill" style={`color:${STALLED_COLOR}`} title={t(lang, "status.stalledHelp", { n: Math.floor(item.stalledDays! / 30) })}>{stalledPill}</span>
      )}
    </span>
  </div>

  {item.forkOf && <p class="forkline">⑂ {t(lang, "card.fork")} {item.forkOf.label}</p>}

  <h3>{item.name}</h3>
  {(item.repo || item.type === "recomp") && <p class="repo">{item.repo ?? repoFallback}</p>}
  </div>
  </div>
  <p class="desc">{item.desc}</p>

  {
    item.requirements && (
      <p class="reqs"><span class="reqs-k">{t(lang, "card.reqs")}</span>{item.requirements}</p>
    )
  }

  {
    item.progress != null && (
      <div class="prog">
        <div class="bar"><i style={`width:${item.progress}%`} /></div>
        <div class="lbl">{item.progressLabel}</div>
      </div>
    )
  }

  <div class="card-foot">
    {
      hasStats && (
        <>
          <span class="stars" title={t(lang, "card.starsTitle")}>★ {fmtStars(item.stars)}</span>
          <span class="dot-sep">·</span>
          <span title={t(lang, "card.lastPush")}>{fmtDate(item.pushedAt)}</span>
        </>
      )
    }
    <span class="repolink">{t(lang, "card.see")}</span>
  </div>
</a>
