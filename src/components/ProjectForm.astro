---
// Formulario único para Contribuir (mode="new") y Editar (mode="edit").
// - Campos completos (estado nuevo, abandonado, requisitos).
// - Los campos bilingües (desc, requisitos) muestran SOLO el idioma actual;
//   se guardan como string (el esquema lo copia a ambos). En edición se
//   preserva la otra traducción si ya existía.
// - Al enviar: abre un ISSUE de GitHub prellenado con el YAML + mensaje
//   "gracias, en revisión". Nunca el editor de archivos.
import { getCollection } from "astro:content";
import { GITHUB_URL } from "../lib/site";
import { href } from "../lib/url";
import { CONSOLE_KEYS, consoleMeta } from "../lib/consoles";
import { STATUS_KEYS, TOOL_STATUS_KEYS } from "../lib/status";
import { t, type Lang } from "../i18n";
import type { ItemType } from "../lib/catalog";

interface Props {
  lang: Lang;
  mode: "new" | "edit";
  type?: ItemType;
  path?: string;
  data?: any;
}
const { lang, mode, type: fixedType, path, data } = Astro.props;
const es = lang === "es";
const otherLang: Lang = es ? "en" : "es";
const d = data ?? {};
const curType: ItemType = (fixedType ?? "recomp") as ItemType;
const toolStatusKeys = TOOL_STATUS_KEYS;

const L = es
  ? { type: "Tipo", tRecomp: "Juego (recomp)", tTool: "Herramienta / launcher", tPort: "Port / remake", tDecomp: "Decompilación", tMod: "Mod / herramienta de mods",
      modKind: "Tipo de mod", game: "Juego sobre el que funciona",
      games: "Juego o juegos", gamesPh: "Super Mario 64",
      gamesHint: "Escribe y elige de la lista; si no está, escríbelo y pulsa Intro. En un launcher, los juegos que instala; en una herramienta genérica, déjalo vacío.",
      remove: "Quitar",
      name: "Nombre", console: "Consola", kind: "Tipo de herramienta", category: "Categoría", status: "Estado",
      abandoned: "Abandonado", takedown: "Retirado (DMCA)", repo: "Repositorio (usuario/repo)", author: "Autor / mantenedor",
      desc: "Descripción", reqs: "Requisitos (qué ROM o versión del juego hace falta)", tags: "Etiquetas (separadas por comas)",
      langHint: "En español; de la versión en inglés nos encargamos nosotros.", repoHint: "usuario/MiRecomp",
      submit: mode === "edit" ? "Enviar cambios" : "Añadir", need: "Escribe al menos el nombre y la descripción.",
      doneTitle: "¡Gracias por contribuir!", doneBody: "Tu propuesta se abrió como issue en GitHub y está en revisión. Cuando la aprobemos, aparecerá en el sitio.",
      again: mode === "edit" ? "Editar de nuevo" : "Añadir otro" }
  : { type: "Type", tRecomp: "Game (recomp)", tTool: "Tool / launcher", tPort: "Port / remake", tDecomp: "Decompilation", tMod: "Mod / modding tool",
      modKind: "Mod type", game: "Game it works on",
      games: "Game or games", gamesPh: "Super Mario 64",
      gamesHint: "Type and pick from the list; if it isn’t there, type it and press Enter. For a launcher, the games it installs; for a generic tool, leave it empty.",
      remove: "Remove",
      name: "Name", console: "Console", kind: "Tool type", category: "Category", status: "Status",
      abandoned: "Abandoned", takedown: "Taken down (DMCA)", repo: "Repository (owner/repo)", author: "Author / maintainer",
      desc: "Description", reqs: "Requirements (which ROM or game version is needed)", tags: "Tags (comma-separated)",
      langHint: "In English; we’ll take care of the Spanish version.", repoHint: "owner/MyRecomp",
      submit: mode === "edit" ? "Submit changes" : "Add", need: "Enter at least the name and the description.",
      doneTitle: "Thanks for contributing!", doneBody: "Your proposal was opened as a GitHub issue and is under review. Once we approve it, it will appear on the site.",
      again: mode === "edit" ? "Edit again" : "Add another" };

const showFor = (t: ItemType, set: ItemType[]) => (set.includes(t) ? "" : "none");
// En edición, los juegos que ya tiene la ficha, con su nombre. La lista entera
// se descarga de games.json solo cuando alguien escribe en el campo.
const gameNames = new Map((await getCollection("games")).map((g) => [g.id, g.data.name]));
const prevGames = ((d.games ?? []) as string[]).map((id) => ({ id, n: gameNames.get(id) ?? id }));
const cfg = {
  mode, gh: GITHUB_URL, lang, otherLang, fixedType: fixedType ?? null,
  path: path ?? null, prevDesc: d.desc ?? null, prevReq: d.requirements ?? null, prevGame: d.game ?? null,
  gamesSrc: href("games.json"), prevGames, removeLabel: L.remove,
};
---

<div class="contrib-form" id="pf-form" style="max-width:520px">
  {
    mode === "new" && (
      <div class="fld">
        <label for="pf-type">{L.type}</label>
        <select id="pf-type">
          <option value="recomp">{L.tRecomp}</option>
          <option value="tool">{L.tTool}</option>
          <option value="port">{L.tPort}</option>
          <option value="decomp">{L.tDecomp}</option>
          <option value="mod">{L.tMod}</option>
        </select>
      </div>
    )
  }
  <div class="fld"><label for="pf-name">{L.name}</label><input id="pf-name" value={d.name ?? ""} placeholder="Conker's Bad Fur Day" /></div>

  <div class="fld" data-row="games">
    <label for="pf-games">{L.games}</label>
    <div class="chips" id="pf-games-chips"></div>
    <input id="pf-games" list="pf-games-list" autocomplete="off" placeholder={L.gamesPh} />
    <datalist id="pf-games-list"></datalist>
    <p class="fld-hint">{L.gamesHint}</p>
  </div>

  <div class="fld" data-row="console" style={`display:${mode === "edit" ? showFor(curType, ["recomp", "port", "decomp", "mod"]) : ""}`}>
    <label for="pf-console">{L.console}</label>
    <select id="pf-console">{CONSOLE_KEYS.map((k) => <option value={k} selected={d.console === k}>{consoleMeta(k, lang).label}</option>)}</select>
  </div>
  <div class="fld" data-row="kind" style={`display:${mode === "edit" ? showFor(curType, ["tool"]) : "none"}`}>
    <label for="pf-kind">{L.kind}</label>
    <select id="pf-kind">{(["recompiler", "launcher", "patcher", "library"] as const).map((k) => <option value={k} selected={d.kind === k}>{t(lang, `toolkind.${k}`)}</option>)}</select>
  </div>
  <div class="fld" data-row="modkind" style={`display:${mode === "edit" ? showFor(curType, ["mod"]) : "none"}`}>
    <label for="pf-modkind">{L.modKind}</label>
    <select id="pf-modkind">{(["mod", "editor", "manager"] as const).map((k) => <option value={k} selected={d.kind === k}>{t(lang, `modkind.${k}`)}</option>)}</select>
  </div>
  <div class="fld" data-row="game" style={`display:${mode === "edit" ? showFor(curType, ["mod"]) : "none"}`}>
    <label for="pf-game">{L.game}</label><input id="pf-game" value={d.game?.[lang] ?? ""} />
  </div>
  <div class="fld" data-row="category" style={`display:${mode === "edit" ? showFor(curType, ["port"]) : "none"}`}>
    <label for="pf-category">{L.category}</label>
    <select id="pf-category">{(["decomp-port", "fan-remake", "native-layer", "game-engine", "source-port"] as const).map((k) => <option value={k} selected={d.category === k}>{t(lang, `category.${k}`)}</option>)}</select>
  </div>
  <div class="fld" data-row="status" style={`display:${mode === "edit" ? showFor(curType, ["recomp", "port", "tool", "mod"]) : ""}`}>
    <label for="pf-status">{L.status}</label>
    <select id="pf-status">
      {STATUS_KEYS.map((s) => <option value={s} data-for="game" selected={d.status === s}>{t(lang, `status.${s}`)}</option>)}
      {toolStatusKeys.map((s) => <option value={s} data-for="tool" selected={d.status === s}>{t(lang, `toolstatus.${s}`)}</option>)}
    </select>
  </div>
  <div class="fld fld-check" data-row="abandoned" style={`display:${mode === "edit" ? showFor(curType, ["recomp", "port", "tool", "decomp"]) : ""}`}>
    <label><input type="checkbox" id="pf-abandoned" checked={d.abandoned} /> {L.abandoned}</label>
  </div>
  <div class="fld fld-check" data-row="takedown" style={`display:${mode === "edit" ? showFor(curType, ["recomp", "port", "tool", "decomp"]) : ""}`}>
    <label><input type="checkbox" id="pf-takedown" checked={d.takedown} /> {L.takedown}</label>
  </div>

  <div class="fld"><label for="pf-repo">{L.repo}</label><input id="pf-repo" value={d.repo ?? ""} placeholder={L.repoHint} /></div>
  <div class="fld"><label for="pf-author">{L.author}</label><input id="pf-author" value={d.author ?? ""} /></div>
  <div class="fld"><label for="pf-desc">{L.desc}</label><textarea id="pf-desc" placeholder={L.langHint}>{d.desc?.[lang] ?? ""}</textarea></div>
  <div class="fld" data-row="reqs" style={`display:${mode === "edit" ? showFor(curType, ["recomp", "port", "mod"]) : ""}`}>
    <label for="pf-reqs">{L.reqs}</label><input id="pf-reqs" value={d.requirements?.[lang] ?? ""} />
  </div>
  <div class="fld"><label for="pf-tags">{L.tags}</label><input id="pf-tags" value={(d.tags ?? []).join(", ")} /></div>

  <div class="actions" style="margin-top:6px"><button class="btn primary" id="pf-submit" type="button">{L.submit}</button></div>
  <p class="note" id="pf-note" style="display:none">{L.need}</p>
</div>

<div class="contrib-done" id="pf-done" style="display:none">
  <div class="done-card">
    <div class="done-check">✓</div>
    <h2>{L.doneTitle}</h2>
    <p>{L.doneBody}</p>
    <button class="btn" id="pf-again" type="button">{L.again}</button>
  </div>
</div>

<script is:inline type="application/json" id="pf-cfg" set:html={JSON.stringify(cfg)} />

<script>
  import { stringify } from "yaml";
  const form = document.getElementById("pf-form");
  const cfgEl = document.getElementById("pf-cfg");
  if (form && cfgEl) {
    const cfg = JSON.parse(cfgEl.textContent || "{}");
    const $ = (id: string) => document.getElementById(id) as any;
    const typeEl = $("pf-type");
    const statusEl = $("pf-status") as HTMLSelectElement;
    const rows: Record<string, HTMLElement | null> = {
      console: document.querySelector('[data-row="console"]'),
      kind: document.querySelector('[data-row="kind"]'),
      modkind: document.querySelector('[data-row="modkind"]'),
      game: document.querySelector('[data-row="game"]'),
      category: document.querySelector('[data-row="category"]'),
      status: document.querySelector('[data-row="status"]'),
      abandoned: document.querySelector('[data-row="abandoned"]'),
      reqs: document.querySelector('[data-row="reqs"]'),
    };
    const curType = () => (cfg.fixedType ?? (typeEl ? typeEl.value : "recomp"));
    const FOLDER: Record<string, string> = { recomp: "recomps", tool: "tools", port: "ports", decomp: "decomps", mod: "mods" };

    function sync() {
      const ty = curType();
      const show = (el: HTMLElement | null, on: boolean) => { if (el) el.style.display = on ? "" : "none"; };
      show(rows.console, ty === "recomp" || ty === "port" || ty === "decomp" || ty === "mod");
      show(rows.kind, ty === "tool");
      show(rows.modkind, ty === "mod");
      show(rows.game, ty === "mod");
      show(rows.category, ty === "port");
      show(rows.status, ty !== "decomp");
      show(rows.reqs, ty === "recomp" || ty === "port" || ty === "mod");
      // estados válidos según tipo (los mods usan la escala de las herramientas)
      const want = ty === "tool" || ty === "mod" ? "tool" : "game";
      let firstVisible = "";
      for (const o of Array.from(statusEl.options)) {
        const ok = o.dataset.for === want;
        o.hidden = !ok;
        o.disabled = !ok;
        if (ok && !firstVisible) firstVisible = o.value;
      }
      const sel = statusEl.selectedOptions[0];
      if (!sel || sel.hidden) statusEl.value = firstVisible;
    }
    if (typeEl) typeEl.addEventListener("change", sync);
    sync();

    // Juegos: cada uno elegido se muestra como un chip. La lista se descarga la
    // primera vez que alguien escribe en el campo; lo que no esté en ella entra
    // como texto libre y lo añadimos al registro al revisar el issue.
    type Picked = { id: string | null; n: string };
    type Known = { id: string; n: string; y: number | null };
    const chipsEl = $("pf-games-chips") as HTMLElement;
    const gamesIn = $("pf-games") as HTMLInputElement;
    const listEl = $("pf-games-list") as HTMLDataListElement;
    const picked: Picked[] = [...(cfg.prevGames ?? [])];
    let known: Known[] | null = null;
    const label = (g: Known) => (g.y ? `${g.n} (${g.y})` : g.n);
    async function loadGames() {
      if (known) return;
      known = [];
      try {
        known = (await (await fetch(cfg.gamesSrc)).json()).games as Known[];
      } catch {
        return;
      }
      listEl.replaceChildren(...known.map((g) => Object.assign(document.createElement("option"), { value: label(g) })));
    }
    function renderChips() {
      chipsEl.replaceChildren(
        ...picked.map((g, i) => {
          const b = document.createElement("button");
          b.type = "button";
          b.className = "chip";
          b.title = cfg.removeLabel;
          b.textContent = `${g.n} ×`;
          b.addEventListener("click", () => {
            picked.splice(i, 1);
            renderChips();
          });
          return b;
        }),
      );
    }
    function addGame() {
      const v = gamesIn.value.trim();
      if (!v) return;
      const hit = known?.find((g) => label(g) === v || g.n.toLowerCase() === v.toLowerCase());
      const g: Picked = hit ? { id: hit.id, n: hit.n } : { id: null, n: v };
      if (!picked.some((p) => (p.id ?? p.n) === (g.id ?? g.n))) picked.push(g);
      gamesIn.value = "";
      renderChips();
    }
    gamesIn.addEventListener("focus", loadGames);
    gamesIn.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        addGame();
      }
    });
    // Elegir una opción de la lista deja en el campo su texto completo.
    gamesIn.addEventListener("input", () => {
      if (known?.some((g) => label(g) === gamesIn.value)) addGame();
    });
    renderChips();

    const slugify = (s: string) =>
      (s || "").toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "") || "nuevo";

    function localized(curVal: string, prev: any) {
      if (!curVal) return undefined;
      const other = prev && prev[cfg.otherLang];
      if (other && other !== curVal) return cfg.lang === "es" ? { es: curVal, en: other } : { es: other, en: curVal };
      return curVal; // string → el esquema lo copia a ambos idiomas
    }

    $("pf-submit").addEventListener("click", () => {
      const ty = curType();
      const name = $("pf-name").value.trim();
      const descVal = $("pf-desc").value.trim();
      if (!name || !descVal) { $("pf-note").style.display = "block"; return; }
      $("pf-note").style.display = "none";

      const o: Record<string, any> = { name };
      const gameIds = picked.filter((g) => g.id).map((g) => g.id);
      if (gameIds.length) o.games = gameIds;
      if (ty === "recomp" || ty === "port" || ty === "decomp" || ty === "mod") o.console = $("pf-console").value;
      if (ty === "mod") { o.kind = $("pf-modkind").value; const g = localized($("pf-game").value.trim(), cfg.prevGame); if (g !== undefined) o.game = g; }
      if (ty === "tool") { o.kind = $("pf-kind").value; o.consoles = [$("pf-console").value]; }
      if (ty === "port") o.category = $("pf-category").value;
      if (ty !== "decomp") o.status = statusEl.value;
      if ($("pf-abandoned")?.checked) o.abandoned = true;
      if ($("pf-takedown")?.checked) o.takedown = true;
      const repo = $("pf-repo").value.trim().replace(/^https?:\/\/github\.com\//, "").replace(/\/$/, "");
      if (repo) o.repo = repo;
      const author = $("pf-author").value.trim(); if (author) o.author = author;
      const descV = localized(descVal, cfg.prevDesc); if (descV !== undefined) o.desc = descV;
      if (ty === "recomp" || ty === "port" || ty === "mod") { const r = localized($("pf-reqs").value.trim(), cfg.prevReq); if (r !== undefined) o.requirements = r; }
      const tags = $("pf-tags").value.split(",").map((s: string) => s.trim()).filter(Boolean);
      if (tags.length) o.tags = tags;

      const yaml = stringify(o, { lineWidth: 0 });
      const filePath = cfg.path ?? `src/data/${FOLDER[ty]}/${slugify(name)}.yaml`;
      const prefix = cfg.mode === "edit" ? `[editar ${ty}]` : `[${ty}]`;
      const pending = typeof o.desc === "string" ? `\n\n> ⚠️ Falta traducción (${cfg.otherLang}).` : "";
      const newGames = picked.filter((g) => !g.id).map((g) => g.n);
      const unknown = newGames.length ? `\n\n**Juegos que no están en el registro (\`src/data/games.yaml\`):** ${newGames.join(", ")}` : "";
      const body = `**Archivo:** \`${filePath}\`\n\n\`\`\`yaml\n${yaml}\`\`\`${unknown}${pending}\n\n_Enviado desde el formulario de Recompendium._`;
      const url = `${cfg.gh}/issues/new?title=${encodeURIComponent(prefix + " " + name)}&body=${encodeURIComponent(body)}`;
      window.open(url, "_blank", "noopener");
      form.style.display = "none";
      document.getElementById("pf-done")!.style.display = "block";
    });

    document.getElementById("pf-again")?.addEventListener("click", () => {
      document.getElementById("pf-done")!.style.display = "none";
      form.style.display = "grid";
    });
  }
</script>
